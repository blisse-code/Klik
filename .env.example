# Supabase project (public — safe to expose to the client)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase service role (server-only — NEVER expose to client; used to verify JWTs and read user profiles)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
